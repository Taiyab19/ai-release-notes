# AI Release Notes Generator — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Anthropic API Key ─────────────────────────────────────────────
# Get your free API key at: https://console.anthropic.com
# Leave blank to use --mock mode (no API key needed)
ANTHROPIC_API_KEY=your_api_key_here

# ── Optional defaults ─────────────────────────────────────────────
DEFAULT_APP_NAME=my-application
DEFAULT_ENVIRONMENT=Production
